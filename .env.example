DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_HOSTNAME=
DATABASE_PORT=
# For Neon/managed Postgres use: require
DATABASE_SSLMODE=

SECRET_KEY=
ALGORITHM=
ACCESS_TOKEN_EXPIRE_MINUTES=
REFRESH_TOKEN_EXPIRE_DAYS=7

REDIS_URL=

EMAIL_PROVIDER=
# SMTP_* / FROM_EMAIL required when EMAIL_PROVIDER is not resend.
SMTP_HOST=
SMTP_PORT=
RESEND_API_KEY=
FROM_EMAIL=

# allows username change to these admins
ADMIN_EMAILS=

DODOPAYMENTS_API_KEY=
DODOPAYMENTS_WEBHOOK_KEY=
DODOPAYMENTS_ENVIRONMENT=
DODOPAYMENTS_PRODUCT_ID=
DODOPAYMENTS_LIFETIME_PRODUCT_ID=

# Origin of this FastAPI service (no trailing slash). Email links for reset-password,
# unsubscribe, and confirm-subscription use this host.
PUBLIC_BASE_URL=http://localhost:8000
UPLOADS_DIR=
STORAGE_BACKEND=
R2_ACCOUNT_ID=
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_PUBLIC_BASE_URL=
# Same public R2 URL for Next.js <Image /> allowlist (optional; set in web env / Vercel).
NEXT_PUBLIC_R2_PUBLIC_BASE_URL=
DEFAULT_PROFILE_IMAGE_URL=

# Reader-facing site origin for blog URLs in notification emails (match NEXT_PUBLIC_MARKETING_ORIGIN in prod).
MARKETING_ORIGIN=http://localhost:3000

# UGC (user-generated content) origin — where user blogs live (e.g. https://articurls.site).
UGS_ORIGIN=http://localhost:3000

# Comma-separated browser origins allowed to call the API (Next.js dev server)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Next.js app URL for links in verification email (e.g. https://app.articurls.com)
APP_BASE_URL=http://localhost:3000

# Public API base used by browser and server components.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Marketing/public origin (canonical URLs, nav, branding). Keep in sync with MARKETING_ORIGIN on the API.
NEXT_PUBLIC_MARKETING_ORIGIN=https://articurls.com

# UGC origin — where user blogs are served. Keep in sync with UGS_ORIGIN on the API.
NEXT_PUBLIC_UGS_ORIGIN=https://articurls.site

# App origin (login/dashboard domain).
NEXT_PUBLIC_APP_ORIGIN=https://app.articurls.com

# Default platform favicon (R2 URL). Set to your favicons/favicon.ico in R2.
NEXT_PUBLIC_DEFAULT_FAVICON_URL=

# Production split example: PUBLIC_BASE_URL=https://api.example.com, MARKETING_ORIGIN and
# NEXT_PUBLIC_MARKETING_ORIGIN=https://example.com, APP_BASE_URL / NEXT_PUBLIC_APP_ORIGIN=https://app.example.com


# Vercel — register each customer hostname on the frontend project
# Create token: https://vercel.com/account/tokens
VERCEL_API_TOKEN=
VERCEL_PROJECT_NAME=
# Optional if project is under a team:
VERCEL_TEAM_ID=

# Internal API secret for middleware <-> backend communication
INTERNAL_API_SECRET=

# Database connection pool
# 2GB droplet: DB_POOL_SIZE=5, DB_MAX_OVERFLOW=5
# 4GB droplet: DB_POOL_SIZE=8,  DB_MAX_OVERFLOW=12 (max_connections=100)
# 8GB droplet: DB_POOL_SIZE=10, DB_MAX_OVERFLOW=20
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800

# Google OAuth Configuration
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret
GOOGLE_REDIRECT_URI=https://api.articurls.com/auth/google/callback

# --- Umami analytics (self-hosted) ---
# Separate Neon *database* from Articurls (same Neon project is OK; never share one database).
# Used by Umami on the DO droplet only — Articurls API DATABASE_* must stay on the app database.
UMAMI_DATABASE_URL=

# Umami admin API (Articurls backend creates one website per user). Server-side only — never expose to browser.
UMAMI_API_URL=
UMAMI_API_USERNAME=
UMAMI_API_PASSWORD=

# Next.js proxy target (Route Handler + /script.js rewrite). Server-side only — not NEXT_PUBLIC_*.
# Production example: https://analytics.articurls.com
# Leave empty in local dev until Umami is running; tracking stays disabled when unset.
UMAMI_ORIGIN=