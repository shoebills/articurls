# Copy to .env on the DO droplet (never commit .env).

# Neon direct connection — same value as UMAMI_DATABASE_URL in Articurls .env
DATABASE_URL=postgresql://USER:PASS@ep-xxx.region.aws.neon.tech/umami?sslmode=require
DATABASE_TYPE=postgresql

# Generate once: openssl rand -hex 32
APP_SECRET=

# Geo + IP — must match web/lib/umami-server.ts UMAMI_VISITOR_IP_HEADER.
# Do NOT use x-forwarded-for: CF on analytics.* overwrites it with Vercel egress (wrong geo).
CLIENT_IP_HEADER=x-articurls-visitor-ip
SKIP_LOCATION_HEADERS=1

DISABLE_TELEMETRY=1

# Pro dashboard iframe (build-time on official image — set here and rebuild if iframe blocked)
ALLOWED_FRAME_URLS=https://app.articurls.com
