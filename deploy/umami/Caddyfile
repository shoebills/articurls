# Public HTTPS for Umami. Caddy obtains a Let's Encrypt cert automatically.
# Set ANALYTICS_HOSTNAME in docker-compose (default: analytics.articurls.com).

{$ANALYTICS_HOSTNAME:analytics.articurls.com} {
	reverse_proxy umami:3000

	# Allow the share dashboard to be embedded in app.articurls.com.
	# Umami's official image bakes ALLOWED_FRAME_URLS at build time so the
	# runtime env var has no effect — strip the restrictive headers here instead.
	header {
		-X-Frame-Options
		Content-Security-Policy "frame-ancestors 'self' https://app.articurls.com"
	}
}
