# Database connection pool
# 2GB droplet: DB_POOL_SIZE=5,  DB_MAX_OVERFLOW=5  (max_connections=25)
# 4GB droplet: DB_POOL_SIZE=8,  DB_MAX_OVERFLOW=12 (max_connections=100)
# 8GB droplet: DB_POOL_SIZE=10, DB_MAX_OVERFLOW=20 (max_connections=200)
